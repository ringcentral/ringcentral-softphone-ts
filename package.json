{
  "name": "ringcentral-softphone",
  "version": "2.0.0-beta.1",
  "homepage": "https://github.com/ringcentral/ringcentral-softphone-ts",
  "license": "MIT",
  "type": "module",
  "types": "dist/index.d.mts",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "in": "tsx --import ./demos/load-env.ts demos/inbound-call.ts",
    "out": "tsx --import ./demos/load-env.ts demos/outbound-call.ts",
    "join": "tsx --import ./demos/load-env.ts demos/join-rcv-meeting.ts",
    "multi-call": "tsx --import ./demos/load-env.ts demos/multiple-calls-sequentially.ts",
    "multi-inst": "tsx --import ./demos/load-env.ts demos/multi-instances.ts",
    "test": "vitest run --exclude 'tests/e2e/**'",
    "test:e2e": "vitest run tests/e2e",
    "validate": "biome check . && tsc -p demos/tsconfig.json && tsc -p tests/tsconfig.json && pnpm run test && pnpm run build && tsc -p tests/package/tsconfig.json && node tests/package/runtime.mjs && node tests/package/runtime.cjs",
    "build": "tsdown",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@evan/opus": "^1.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^25.9.5",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.17.0"
}
