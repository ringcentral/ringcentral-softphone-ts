{
  "name": "ringcentral-softphone",
  "version": "2.0.0-beta.1",
  "homepage": "https://github.com/ringcentral/ringcentral-softphone-ts",
  "license": "MIT",
  "type": "module",
  "types": "dist/index.d.mts",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "in": "rm -f -- *.wav *.raw && tsx -r dotenv-override-true/config demos/inbound-call.ts",
    "out": "rm -f -- *.wav *.raw && tsx -r dotenv-override-true/config demos/outbound-call.ts",
    "join": "rm -f -- *.wav *.raw && tsx -r dotenv-override-true/config demos/join-rcv-meeting.ts",
    "multi-call": "tsx -r dotenv-override-true/config demos/multiple-calls-sequentially.ts",
    "multi-inst": "tsx -r dotenv-override-true/config demos/multi-instances.ts",
    "lint": "biome check --write .",
    "test": "vitest run --exclude 'tests/e2e/**'",
    "test:e2e": "vitest run tests/e2e",
    "typecheck": "tsc --noEmit",
    "typecheck:demos": "tsc -p demos/tsconfig.json",
    "typecheck:tests": "tsc -p tests/tsconfig.json",
    "test:package": "pnpm run build && tsc -p tests/package/tsconfig.json && node tests/package/runtime.mjs && node tests/package/runtime.cjs",
    "validate": "pnpm run typecheck && pnpm run typecheck:demos && pnpm run typecheck:tests && pnpm run test && pnpm run test:package",
    "build": "tsdown",
    "prepublishOnly": "pnpm run build",
    "postpublish": "rm -rf dist"
  },
  "dependencies": {
    "@evan/opus": "^1.0.3",
    "debug": "^4.4.3",
    "wait-for-async": "^0.8.1",
    "werift-rtp": "^0.8.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^25.8.0",
    "dotenv-override-true": "^6.2.2",
    "tsdown": "^0.22.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "packageManager": "pnpm@11.17.0"
}
